{
  "name": "solas-redact",
  "version": "1.0.0",
  "private": true,
  "description": "Solas Redact: permanent PDF redaction in the browser. Files never leave the computer.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node tools/copy-vendor.mjs && vite",
    "build": "node tools/copy-vendor.mjs && tsc --noEmit && vite build && node --import tsx tools/build-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "node tools/record-unit.mjs",
    "test:e2e": "node --import tsx tests/e2e/run.ts",
    "stress": "node --import tsx tests/e2e/stress.ts",
    "licences": "node tools/licences.mjs",
    "icons": "node tools/make-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "fflate": "0.8.3",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "marked": "18.1.2",
    "puppeteer-core": "25.16.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOLAS33/solas-redact.git"
  },
  "homepage": "https://redact.solas33.com/",
  "bugs": {
    "url": "https://github.com/SOLAS33/solas-redact/issues"
  }
}
